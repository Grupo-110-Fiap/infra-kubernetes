# Terraform Variables for Production Environment
aws_region = "us-east-1"
environment = "production"
cluster_name = "techchallenge-eks"
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
image_tag = "latest"

# Note: The following variables should be set via environment variables or GitHub secrets:
# terraform_state_bucket = "your-terraform-state-bucket"
# database_url = "will be auto-generated by RDS"
